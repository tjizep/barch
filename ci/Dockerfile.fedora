# Stands in for the Fedora GitHub job, which builds in a fedora container.
#
# Only what the build reaches for is here, the same as the Ubuntu images. A
# missing dependency shows up as a build failure rather than being masked.
FROM fedora:latest
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ make cmake git swig \
        python3 python3-devel python3-pip \
        java-latest-openjdk-devel maven \
        openssl-devel pkgconf-pkg-config ca-certificates curl \
        diffutils findutils which perl procps-ng \
    && dnf clean all
