# Stands in for the ubuntu-22.04 GitHub runner (gcc 11).
#
# The hosted runner images come with far more than this preinstalled. Only what
# the build actually reaches for is here, which keeps the image small and makes
# a missing dependency show up as a build failure rather than being masked.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git swig \
        python3 python3-dev python3-venv python3-pip \
        default-jdk maven \
        libssl-dev pkg-config ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
