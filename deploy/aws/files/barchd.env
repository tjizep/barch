# Settings for barchd.service. Restart the service after a change:
#   sudo systemctl restart barchd
#
# The address barchd listens on. 0.0.0.0 is every interface. Clients must log in,
# because first boot takes the rights away from the default user. Limit who can
# reach the port with the instance's security group.
BARCHD_BIND=0.0.0.0
BARCHD_PORT=14000
# More barchd options, for example: --config max_memory_bytes=4294967296
BARCHD_OPTS=
# Any barch setting can also be set here as BARCH_<NAME>, for example
# BARCH_SAVE_INTERVAL=60000
